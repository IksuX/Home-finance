#!/bin/bash
# Budżet domowy – uruchamia lokalny serwer (jeśli jeszcze nie działa) i otwiera aplikację w przeglądarce.
APP="$(cd "$(dirname "$0")/../Resources/app" && pwd)"
PORT=8765
URL="http://127.0.0.1:$PORT/"
DATA="$HOME/Library/Application Support/BudzetDomowy"
mkdir -p "$DATA"

running() { /usr/bin/curl -s -o /dev/null --max-time 1 "${URL}api/state"; }
if running; then /usr/bin/open "$URL"; exit 0; fi

PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3; do
  if [ -x "$c" ] && "$c" -c 'import sys,sqlite3; sys.exit(0 if sys.version_info >= (3,8) else 1)' 2>/dev/null; then PY="$c"; break; fi
done
# /usr/bin/python3 działa dopiero po zainstalowaniu narzędzi Apple (inaczej wyświetla okno instalatora)
if [ -z "$PY" ] && /usr/bin/xcode-select -p >/dev/null 2>&1 && /usr/bin/python3 -c 'import sqlite3' 2>/dev/null; then PY=/usr/bin/python3; fi
if [ -z "$PY" ]; then
  /usr/bin/osascript -e 'display dialog "Budżet domowy potrzebuje bezpłatnych narzędzi Apple (zawierają Pythona i odczyt tekstu z paragonów).\n\nOtwórz Terminal, wpisz:\n\nxcode-select --install\n\ni po zakończeniu instalacji uruchom program ponownie." buttons {"OK"} default button 1 with title "Budżet domowy" with icon caution'
  exit 1
fi

BUDZET_PORT=$PORT nohup "$PY" "$APP/server.py" >> "$DATA/program.log" 2>&1 &
disown
for i in $(seq 1 40); do
  if running; then /usr/bin/open "$URL"; exit 0; fi
  sleep 0.25
done
/usr/bin/osascript -e 'display dialog "Nie udało się uruchomić programu. Szczegóły są w pliku program.log w folderze Biblioteki/Application Support/BudzetDomowy." buttons {"OK"} default button 1 with title "Budżet domowy" with icon stop'
exit 1
